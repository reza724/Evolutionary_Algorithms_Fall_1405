{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "const": "1.0"
    },
    "benchmark_id": {
      "const": "benchmark_1"
    },
    "entrypoint": {
      "type": "string",
      "pattern": "^[A-Za-z_][A-Za-z0-9_]*(\\.[A-Za-z_][A-Za-z0-9_]*)*:[A-Za-z_][A-Za-z0-9_]*$"
    },
    "artifacts_dir": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)(?![A-Za-z]:).+$"
    },
    "requirements_file": {
      "type": "string",
      "pattern": "^(?!/)(?!.*\\.\\.)(?!.*\\\\)(?![A-Za-z]:).+$"
    },
    "labels": {
      "const": [
        -1,
        0,
        1
      ]
    }
  },
  "additionalProperties": false,
  "required": [
    "schema_version",
    "benchmark_id",
    "entrypoint",
    "artifacts_dir",
    "requirements_file",
    "labels"
  ]
}
